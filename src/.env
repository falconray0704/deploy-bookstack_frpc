
# frp

## frp image tag
FRP_IMAGE_TAG=0.60.0

## Parent path for deployment
INSTALL_ROOT_PATH=/home/ray/etmp

## Directory for deployment at INSTALL_ROOT_PATH
SERVER_NAME=frpc_bookstack_ray

## Directory for frpc certificates installation
CERTIFICATES_DIR=certs

INSTALL_PATH=$INSTALL_ROOT_PATH/$SERVER_NAME

## Configuration files for frpc
CFGS_DIR=cfgs



# bookstack

# Datas root directory
BOOKSTACK_DATAS_DIR=datas

# bookstack db
MYSQL_RELEASE_VERSION=10.11.8

MYSQL_DATABASE=bookstackapp
MYSQL_USER=bookstack
MYSQL_PASSWORD=password
MYSQL_ROOT_PASSWORD=password

# bookstack domain, eg: https://bookstack.example.com
BOOKSTACK_APP_URL=https://bookstack.example.com

# bookstack image tag
BOOKSTACKAPP_RELEASE_VERSION=24.05.3


SESSION_LIFETIME=43200


